# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_PROVIDER=nvidia

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Gemini embedding configuration (free tier at aistudio.google.com)
# GEMINI_API_KEY=your-key-here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: NVIDIA API Catalog embedding configuration.
# NVIDIA_API_KEY=paste-a-new-key-here
# NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
